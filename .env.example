# Copy to .env and fill in. .env is gitignored — never commit it.
#
# None of this is required just to LOOK at your artifacts: `docker compose up
# -d` on its own gets you http://localhost:8765 (see LOCAL_PREVIEW_PORT
# below), no Tailscale account action needed. Everything below is only for
# publishing to the tailnet / the internet via Funnel.

# Tailscale auth key for this device. Optional — leave blank and the
# container logs (`docker compose logs tailscale`) will print an interactive
# login link instead; open it once to approve the device. A key just skips
# that manual step, handy for unattended/repeat setups.
# Create one at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# MagicDNS hostname for this device. The site will be served at
# https://<TS_HOSTNAME>.<your-tailnet>.ts.net — pick a unique name per device.
TS_HOSTNAME=artifacts

# Local-only preview port (bound to 127.0.0.1, not exposed beyond this
# machine). Reaches Caddy directly, bypassing Tailscale entirely — useful for
# checking an artifact renders right before bothering with tailnet/Funnel
# setup at all.
LOCAL_PREVIEW_PORT=8765

# Optional overrides (defaults shown):
# DISCOVERY_INTERVAL=120
# DISCOVERY_FETCH_TIMEOUT=5
# DISCOVERY_LOG_LEVEL=INFO
