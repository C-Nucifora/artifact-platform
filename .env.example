# Copy to .env and fill in. .env is gitignored — never commit it.

# Tailscale auth key for this device.
# Create one at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-REPLACE_ME

# MagicDNS hostname for this device. The site will be served at
# https://<TS_HOSTNAME>.<your-tailnet>.ts.net — pick a unique name per device.
TS_HOSTNAME=artifacts

# Optional overrides (defaults shown):
# DISCOVERY_INTERVAL=120
# DISCOVERY_FETCH_TIMEOUT=5
# DISCOVERY_LOG_LEVEL=INFO
