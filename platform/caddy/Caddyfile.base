# Plain HTTP on :80 — Tailscale terminates HTTPS and proxies here.
{
	admin off
	auto_https off
}

import /etc/caddy/snippets/*.caddy

:80 {
	import security_headers
	encode zstd gzip

	header /manifest.json Cache-Control "no-cache"
	header /peers.json Cache-Control "no-cache"

	@private path /admin /admin/* /api/admin/* /oauth2 /oauth2/*
	respond @private 404

	handle /manifest.json {
		root * /generated
		file_server
	}

	handle /peers.json {
		root * /generated
		file_server
	}

	handle /artifacts/* {
		root * /srv
		file_server browse
	}

	handle {
		root * /srv/site
		file_server
	}
}
